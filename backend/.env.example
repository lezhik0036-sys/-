# Copy this file to .env ON THE SERVER and fill in the values there.
# Never commit .env. Never put real values in this example file.
#
#   cp .env.example .env && chmod 600 .env && nano .env

# SMS.RU api_id. REQUIRED. Without it the backend fails to start (fail-closed).
# Paste the api_id here on the server only — never in Git, the APK or the image.
MAMA_SMSRU_API_ID=

# Approved SMS.RU sender name. OPTIONAL (leave empty for the default sender).
MAMA_SMS_SENDER=

# Domain for automatic HTTPS (Caddy / the "tls" profile). Leave empty if you are
# not using the bundled Caddy reverse proxy yet.
MAMA_DOMAIN=
